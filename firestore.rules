rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isSelf(email) {
      return signedIn() && callerEmail() == email;
    }

    // E-board status lives on the caller's own user doc, which every
    // signed-in user is allowed to read (see /users/{email} below).
    function isEboard() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(callerEmail())) &&
        get(/databases/$(database)/documents/users/$(callerEmail())).data.eboard == true;
    }

    // Fields a general member may change on their own doc when redeeming
    // an event code (see EventCodeForm.tsx) — never profile/role fields.
    function selfUpdateAllowedFields() {
      return [
        'fallPoints', 'springPoints', 'eventCodes',
        'programmingPointsVE', 'programmingPointsNVE',
        'gbmPointsVE', 'gbmPointsNVE',
        'mlpFallPointsVE', 'mlpFallPointsNVE',
        'mlpSpringPointsVE', 'mlpSpringPointsNVE',
        'opaPointsVE', 'opaPointsNVE',
        'cabinetPoints', 'otherPoints'
      ];
    }

    // Per-Member facts only E-Board sets (ADR-0002). A Member can't write
    // them on update (they're not in selfUpdateAllowedFields) or sneak them
    // in at sign-up.
    function eboardOnlyMemberFields() {
      return [
        'mlpCohort', 'heldToCabinetRules', 'webTeam',
        'excusals', 'strikeRemovals', 'missedEventOverrides', 'adjustments',
        'absenceLog'
      ];
    }

    // absenceLog is the history behind every Excuse Absence change, so it is
    // append-only even for E-Board: the old entries must stay, unchanged and
    // in order, at the front.
    function absenceLogOnlyGrows() {
      let before = resource.data.get('absenceLog', []);
      let after = request.resource.data.get('absenceLog', []);
      return before.size() == 0 ||
        (after.size() >= before.size() && after[0:before.size()] == before);
    }

    match /users/{email} {
      allow get: if isSelf(email) || isEboard();
      allow list: if isEboard();

      // Sign-up creates the caller's own doc; block self-granted eboard
      // status or a non-zero starting point balance.
      allow create: if isSelf(email) &&
        request.resource.data.email == email &&
        request.resource.data.eboard == false &&
        request.resource.data.fallPoints == 0 &&
        request.resource.data.springPoints == 0 &&
        request.resource.data.strikes == 0 &&
        !request.resource.data.keys().hasAny(eboardOnlyMemberFields());

      allow update: if (isEboard() && absenceLogOnlyGrows()) ||
        (isSelf(email) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfUpdateAllowedFields()));

      allow delete: if isEboard();
    }

    match /codes/{code} {
      // Every signed-in member needs to list/read codes (dashboard,
      // voter-eligibility calc, redemption) — but never write them,
      // except for the attendee-count bump on redemption.
      allow get, list: if signedIn();
      allow create, delete: if isEboard();
      allow update: if isEboard() ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount', 'ateendecode']));
    }

    // One doc per Attendance (docs/adr/0002-attendance-ledger-calculated-on-read.md).
    // A Member may only record redeeming a code themselves; request and
    // E-Board sources, and every update or delete, are E-Board-only.
    match /attendances/{id} {
      // The doc EventCodeForm.tsx writes: ID `{email}__{CODE}`, Event Type
      // and date copied from codes/{CODE}, nothing else.
      function isOwnCodeAttendance() {
        let attendance = request.resource.data;
        let code = get(/databases/$(database)/documents/codes/$(attendance.codeId)).data;
        return attendance.keys().hasOnly(['email', 'eventTypeId', 'eventDate', 'source', 'codeId']) &&
          attendance.email == callerEmail() &&
          attendance.source == 'code' &&
          id == callerEmail() + '__' + attendance.codeId &&
          attendance.eventTypeId == code.eventTypeId &&
          attendance.eventDate == code.eventDate;
      }

      // A missing doc (resource == null) is readable so a Member can check
      // "already redeemed?" before writing; it reveals nothing.
      allow get: if isEboard() ||
        (signedIn() && (resource == null || resource.data.email == callerEmail()));
      // Members list only with `where('email', '==', <their email>)`.
      allow list: if isEboard() || (signedIn() && resource.data.email == callerEmail());
      allow create: if isEboard() || (signedIn() && isOwnCodeAttendance());
      allow update, delete: if isEboard();
    }

    match /pointRequests/{id} {
      allow get, list: if isEboard() ||
        (signedIn() && resource.data.userEmail == callerEmail());
      allow create: if signedIn() && request.resource.data.userEmail == callerEmail();
      allow update, delete: if isEboard();
    }

    match /cabinets/{cabinetDoc} {
      allow get, list: if isEboard();
      allow create, delete: if isEboard();

      // Sign-up appends the caller's own email to cabinets/regular or
      // cabinets/pending — allow only that (no removals, no other emails).
      allow update: if isEboard() ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails']) &&
         request.resource.data.emails.hasAll(resource.data.emails) &&
         request.resource.data.emails.hasOnly(resource.data.emails.concat([callerEmail()])));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
